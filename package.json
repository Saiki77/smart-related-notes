{
  "name": "smart-related-notes",
  "version": "3.0.1",
  "description": "Surface notes ranked by local semantic similarity to the one you're reading, as a sidebar card stack.",
  "main": "main.js",
  "scripts": {
    "gen-ort": "node gen-ort.mjs",
    "predev": "node gen-ort.mjs",
    "dev": "node esbuild.config.mjs",
    "prebuild": "node gen-ort.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "prelint": "node gen-ort.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "bench": "node --experimental-strip-types bench/at-rest.mjs",
    "pretest": "node gen-ort.mjs",
    "test": "node bench/glue-prelude-check.mjs && node bench/ort-runtime-check.mjs && npm run test:integration",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test:integration": "node --experimental-transform-types --import ./bench/register-stub.mjs bench/v3-integration.mjs",
    "lint:strict": "eslint --config eslint.strict.mjs \"src/**/*.ts\""
  },
  "keywords": [
    "obsidian",
    "plugin",
    "embeddings",
    "semantic",
    "related"
  ],
  "author": "Saiki77",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1"
  },
  "overrides": {
    "adm-zip": ">=0.6.0",
    "protobufjs": ">=7.6.5",
    "sharp": ">=0.35.0",
    "brace-expansion": ">=5.0.8",
    "fast-uri": ">=3.1.4",
    "js-yaml": ">=4.2.1"
  }
}
